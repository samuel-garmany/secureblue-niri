#!/usr/bin/bash
# /etc/greetd/config.toml plus an [initial_session] block for uid 1000, so no
# username is baked into the image. No uid 1000, no block.
set -eu

install -m 0644 /etc/greetd/config.toml /run/greetd/config.toml

user=$(id -nu 1000 2>/dev/null) || exit 0

cat >> /run/greetd/config.toml <<TOML

[initial_session]
command = "niri-session"
user = "$user"
TOML
